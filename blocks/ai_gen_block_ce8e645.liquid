{% doc %}
  @prompt
    Create a new full-width "image with text overlay" section for the homepage with the following layout:
    
    - A wide background lifestyle image spanning the full width of the page.
    - Text overlaid on the image, left-aligned, in light cream (#F7F3EB):
      • Heading (serif font, large): "Bliv en del af 12.000+ danskere, der har fundet deres stil"
      • Subheading (sans-serif font, smaller): "Mode til både dame og herre – med fokus på selvtillid, komfort og friheden til at føle dig godt tilpas."
    - A round badge in the top-right corner of the image: a cream circle (#F7F3EB) with dark text reading "Få 10% rabat".
    - A call-to-action button placed BELOW the image (not overlaid on it), centered, in burgundy (#6C2D31) with cream text (#F7F3EB), label: "Læs hvad andre siger om Moramero".
    
    Requirements:
    - The button must sit underneath the image, centered and clearly visible, outside the image container.
    - Fully responsive layout.
    - On-brand: cream background (#F7F3EB), burgundy accents (#6C2D31).
    - The section should be a Shopify Liquid section with schema settings for: background image, heading text, subheading text, badge text, button label, and button URL.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-overlay-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.section_background }};
    display: block;
  }

  .ai-image-text-overlay__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-image-text-overlay__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-image-text-overlay__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-image-text-overlay__placeholder-{{ ai_gen_id }} {
    width: 100%;
    background-color: #e5e5e5;
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-overlay__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 500px;
  }

  .ai-image-text-overlay__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-overlay__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    padding: 40px;
  }

  .ai-image-text-overlay__text-container-{{ ai_gen_id }} {
    max-width: 600px;
    text-align: left;
  }

  .ai-image-text-overlay__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px 0;
    line-height: 1.2;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-image-text-overlay__badge-{{ ai_gen_id }} {
    position: absolute;
    top: 30px;
    right: 30px;
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.badge_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
  }

  .ai-image-text-overlay__badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 600;
    line-height: 1.2;
  }

  .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 40px 20px;
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 16px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-overlay__content-{{ ai_gen_id }} {
      padding: 24px;
    }

    .ai-image-text-overlay__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.6 }}px;
    }

    .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-image-text-overlay__badge-{{ ai_gen_id }} {
      width: {{ block.settings.badge_size | times: 0.75 }}px;
      height: {{ block.settings.badge_size | times: 0.75 }}px;
      top: 20px;
      right: 20px;
      padding: 15px;
    }

    .ai-image-text-overlay__badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_text_size | times: 0.85 }}px;
    }

    .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }} {
      padding: 30px 20px;
    }

    .ai-image-text-overlay__button-{{ ai_gen_id }} {
      padding: 14px 28px;
      font-size: {{ block.settings.button_text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-overlay-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-overlay__container-{{ ai_gen_id }}">
    <div class="ai-image-text-overlay__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 2000 }}"
          alt="{{ block.settings.background_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
          class="ai-image-text-overlay__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-text-overlay__placeholder-{{ ai_gen_id }}">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
          <div class="ai-image-text-overlay__empty-state-{{ ai_gen_id }}">
            Add a background image to get started
          </div>
        </div>
      {% endif %}

      <div class="ai-image-text-overlay__content-{{ ai_gen_id }}">
        <div class="ai-image-text-overlay__text-container-{{ ai_gen_id }}">
          {% if block.settings.heading != blank %}
            <h2 class="ai-image-text-overlay__heading-{{ ai_gen_id }}">
              {{ block.settings.heading }}
            </h2>
          {% endif %}

          {% if block.settings.subheading != blank %}
            <div class="ai-image-text-overlay__subheading-{{ ai_gen_id }}">
              {{ block.settings.subheading }}
            </div>
          {% endif %}
        </div>
      </div>

      {% if block.settings.badge_text != blank %}
        <div class="ai-image-text-overlay__badge-{{ ai_gen_id }}">
          <div class="ai-image-text-overlay__badge-text-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.button_label != blank %}
      <div class="ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.button_url }}"
          class="ai-image-text-overlay__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Image with text overlay",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Bliv en del af 12.000+ danskere, der har fundet deres stil</p>"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "serif"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Mode til både dame og herre – med fokus på selvtillid, komfort og friheden til at føle dig godt tilpas.</p>"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F7F3EB"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "inline_richtext",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Få 10% rabat"
    },
    {
      "type": "range",
      "id": "badge_size",
      "label": "Badge size",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "badge_text_size",
      "label": "Badge text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Badge background",
      "default": "#F7F3EB"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button label",
      "default": "Læs hvad andre siger om Moramero"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Button text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#6C2D31"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#F7F3EB"
    },
    {
      "type": "color",
      "id": "button_hover_background",
      "label": "Button hover background",
      "default": "#4a1f22"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#F7F3EB"
    }
  ],
  "presets": [
    {
      "name": "Image with text overlay"
    }
  ]
}
{% endschema %}
