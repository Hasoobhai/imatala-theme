{% doc %}
  @prompt
    Create a new full-width "image with text overlay" section for the homepage with the following layout:
    
    - A wide background lifestyle image spanning the full width of the page.
    - Text overlaid on the image, CENTER-aligned, in light cream (#F7F3EB):
      • Heading (serif font, large): "Bliv en del af 12.000+ danskere, der har fundet deres stil"
      • Subheading (sans-serif font, smaller): "Mode til både dame og herre – med fokus på selvtillid, komfort og friheden til at føle dig godt tilpas."
    - A round badge in the top-right corner of the image: a cream circle (#F7F3EB) with dark text reading "Få 10% rabat".
    - A call-to-action button placed BELOW the image (not overlaid on it), centered, in burgundy (#6C2D31) with cream text (#F7F3EB), label: "Læs hvad andre siger om Moramero".
    
    Requirements:
    - Both the heading and subheading must be horizontally centered (text-align: center) over the image.
    - The button must sit underneath the image, centered and clearly visible, outside the image container.
    - Fully responsive layout.
    - On-brand: cream background (#F7F3EB), burgundy accents (#6C2D31).
    - The section should be a Shopify Liquid section with schema settings for: background image, heading text, subheading text, badge text, button label, and button URL., Can you put the text in the bottom center
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-overlay-{{ ai_gen_id }} {
    width: 100%;
    display: block;
  }

  .ai-image-text-overlay__container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: {{ block.settings.section_background }};
  }

  .ai-image-text-overlay__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-image-text-overlay__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-image-text-overlay__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    min-height: 400px;
    background-color: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-text-overlay__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 600px;
    max-height: 400px;
  }

  .ai-image-text-overlay__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-text-overlay__content-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.text_position_bottom }}px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    width: 90%;
    max-width: 800px;
    z-index: 2;
  }

  .ai-image-text-overlay__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    line-height: 1.2;
    margin: 0 0 16px 0;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
  }

  .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subheading_size_mobile }}px;
    line-height: 1.5;
    margin: 0;
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
  }

  .ai-image-text-overlay__badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badge_position_top }}px;
    right: {{ block.settings.badge_position_right }}px;
    width: {{ block.settings.badge_size }}px;
    height: {{ block.settings.badge_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.badge_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    padding: 10px;
  }

  .ai-image-text-overlay__badge-text-{{ ai_gen_id }} {
    color: {{ block.settings.badge_text_color }};
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: 600;
    text-align: center;
    line-height: 1.2;
  }

  .ai-image-text-overlay__button-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    padding: {{ block.settings.button_spacing_top }}px 20px {{ block.settings.button_spacing_bottom }}px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 500;
    transition: all 0.3s ease;
    text-align: center;
  }

  .ai-image-text-overlay__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-image-text-overlay__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }

    .ai-image-text-overlay__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }

    .ai-image-text-overlay__badge-{{ ai_gen_id }} {
      width: {{ block.settings.badge_size_desktop }}px;
      height: {{ block.settings.badge_size_desktop }}px;
    }

    .ai-image-text-overlay__badge-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.badge_text_size_desktop }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-overlay-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-overlay__container-{{ ai_gen_id }}">
    <div class="ai-image-text-overlay__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.background_image %}
        <img
          src="{{ block.settings.background_image | image_url: width: 2000 }}"
          alt="{{ block.settings.background_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.background_image.width }}"
          height="{{ block.settings.background_image.height }}"
          class="ai-image-text-overlay__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-text-overlay__image-placeholder-{{ ai_gen_id }}">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
          <div class="ai-image-text-overlay__empty-state-{{ ai_gen_id }}">
            Add a background image to get started
          </div>
        </div>
      {% endif %}

      <div class="ai-image-text-overlay__content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-image-text-overlay__heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <p class="ai-image-text-overlay__subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </p>
        {% endif %}
      </div>

      {% if block.settings.show_badge and block.settings.badge_text != blank %}
        <div class="ai-image-text-overlay__badge-{{ ai_gen_id }}">
          <div class="ai-image-text-overlay__badge-text-{{ ai_gen_id }}">
            {{ block.settings.badge_text }}
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.button_label != blank %}
      <div class="ai-image-text-overlay__button-wrapper-{{ ai_gen_id }}">
        <a
          href="{{ block.settings.button_link }}"
          class="ai-image-text-overlay__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
