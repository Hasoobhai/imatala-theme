{% doc %}
  @prompt
    Add a "Featured Collections" section to the homepage styled as a clean single row of collection tiles. The section title is "Udforsk kollektionerne" (Danish). Each tile shows one collection image on a light cream/off-white background (#F7F3EB) with the collection name in Playfair Display serif font below each image in dark text (#1A1A1A). Make this section an auto-rotating carousel: show 5 collections at a time on desktop, auto-advancing every 5 seconds (autoplay, 5000ms interval), looping continuously. Include left/right arrow navigation and pagination dots, with burgundy (#6C2D31) used for the active arrow and active dot states. Fully responsive: 5 tiles on desktop, 2–3 on tablet, 1–2 on mobile. Background of the section should be #F7F3EB. No text overlays on images — collection name appears below the image only.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collections-{{ ai_gen_id }} {
    background-color: {{ block.settings.section_background }};
    padding: 60px 20px;
    width: 100%;
    display: block;
  }

  .ai-featured-collections-container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }

  .ai-featured-collections-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 50px;
  }

  .ai-featured-collections-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-style: {{ block.settings.title_font.style }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
  }

  .ai-featured-collections-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-featured-collections-carousel-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.tile_gap }}px;
  }

  .ai-featured-collections-tile-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.desktop_columns | minus: 1 }} * {{ block.settings.tile_gap }}px)) / {{ block.settings.desktop_columns }});
    background-color: {{ block.settings.tile_background }};
    border-radius: {{ block.settings.tile_border_radius }}px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }

  .ai-featured-collections-tile-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-featured-collections-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    position: relative;
  }

  .ai-featured-collections-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collections-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e5e5e5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collections-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-collections-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.collection_name_font.family }}, {{ block.settings.collection_name_font.fallback_families }};
    font-weight: {{ block.settings.collection_name_font.weight }};
    font-style: {{ block.settings.collection_name_font.style }};
    font-size: {{ block.settings.collection_name_size }}px;
    color: {{ block.settings.collection_name_color }};
    text-align: center;
    padding: 20px 15px;
    margin: 0;
  }

  .ai-featured-collections-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: rgba(255, 255, 255, 0.9);
    border: none;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    z-index: 10;
    color: {{ block.settings.nav_color }};
  }

  .ai-featured-collections-nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_active_color }};
    color: #ffffff;
  }

  .ai-featured-collections-nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-featured-collections-nav-prev-{{ ai_gen_id }} {
    left: -25px;
  }

  .ai-featured-collections-nav-next-{{ ai_gen_id }} {
    right: -25px;
  }

  .ai-featured-collections-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 30px;
  }

  .ai-featured-collections-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #d1d1d1;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-featured-collections-dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.nav_active_color }};
    width: 30px;
    border-radius: 5px;
  }

  @media screen and (max-width: 989px) {
    .ai-featured-collections-tile-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - (2 * {{ block.settings.tile_gap }}px)) / 3);
    }

    .ai-featured-collections-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-featured-collections-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_name_size | times: 0.9 }}px;
    }

    .ai-featured-collections-nav-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-featured-collections-nav-prev-{{ ai_gen_id }} {
      left: -20px;
    }

    .ai-featured-collections-nav-next-{{ ai_gen_id }} {
      right: -20px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-featured-collections-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .ai-featured-collections-tile-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.tile_gap }}px) / 2);
    }

    .ai-featured-collections-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-featured-collections-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.collection_name_size | times: 0.8 }}px;
      padding: 15px 10px;
    }

    .ai-featured-collections-nav-{{ ai_gen_id }} {
      width: 35px;
      height: 35px;
    }

    .ai-featured-collections-nav-prev-{{ ai_gen_id }} {
      left: 5px;
    }

    .ai-featured-collections-nav-next-{{ ai_gen_id }} {
      right: 5px;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-featured-collections-tile-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }
  }
{% endstyle %}

<featured-collections-carousel-{{ ai_gen_id }}
  class="ai-featured-collections-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-interval="{{ block.settings.autoplay_interval }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-featured-collections-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-featured-collections-header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collections-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    <div class="ai-featured-collections-carousel-wrapper-{{ ai_gen_id }}">
      <button
        class="ai-featured-collections-nav-{{ ai_gen_id }} ai-featured-collections-nav-prev-{{ ai_gen_id }}"
        aria-label="Previous collections"
        data-nav="prev"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-featured-collections-carousel-{{ ai_gen_id }}" data-carousel>
        {% if block.settings.collections.count > 0 %}
          {% for collection in block.settings.collections %}
            <a
              href="{{ collection.url }}"
              class="ai-featured-collections-tile-{{ ai_gen_id }}"
              data-tile
            >
              <div class="ai-featured-collections-image-wrapper-{{ ai_gen_id }}">
                {% if collection.featured_image %}
                  <img
                    src="{{ collection.featured_image | image_url: width: 600 }}"
                    alt="{{ collection.featured_image.alt | escape }}"
                    class="ai-featured-collections-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                {% else %}
                  <div class="ai-featured-collections-placeholder-{{ ai_gen_id }}">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <h3 class="ai-featured-collections-name-{{ ai_gen_id }}">{{ collection.title }}</h3>
            </a>
          {% endfor %}
        {% else %}
          {% for i in (1..5) %}
            <div class="ai-featured-collections-tile-{{ ai_gen_id }}" data-tile>
              <div class="ai-featured-collections-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-featured-collections-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              </div>
              <h3 class="ai-featured-collections-name-{{ ai_gen_id }}">Collection {{ i }}</h3>
            </div>
          {% endfor %}
        {% endif %}
      </div>

      <button
        class="ai-featured-collections-nav-{{ ai_gen_id }} ai-featured-collections-nav-next-{{ ai_gen_id }}"
        aria-label="Next collections"
        data-nav="next"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-featured-collections-pagination-{{ ai_gen_id }}" data-pagination></div>
  </div>
</featured-collections-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class FeaturedCollectionsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayTimer = null;
        this.isTransitioning = false;
      }

      connectedCallback() {
        this.carousel = this.querySelector('[data-carousel]');
        this.tiles = this.querySelectorAll('[data-tile]');
        this.prevButton = this.querySelector('[data-nav="prev"]');
        this.nextButton = this.querySelector('[data-nav="next"]');
        this.paginationContainer = this.querySelector('[data-pagination]');
        this.autoplay = this.dataset.autoplay === 'true';
        this.interval = parseInt(this.dataset.interval) || 5000;

        this.setupCarousel();
        this.setupEventListeners();
        this.createPagination();
        this.updateCarousel();

        if (this.autoplay && this.tiles.length > this.getVisibleCount()) {
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      setupCarousel() {
        this.totalTiles = this.tiles.length;
        this.visibleCount = this.getVisibleCount();
        this.maxIndex = Math.max(0, this.totalTiles - this.visibleCount);
      }

      getVisibleCount() {
        const width = window.innerWidth;
        if (width <= 480) {
          return 1;
        } else if (width <= 749) {
          return 2;
        } else if (width <= 989) {
          return 3;
        } else {
          return {{ block.settings.desktop_columns }};
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.navigate('prev'));
        this.nextButton.addEventListener('click', () => this.navigate('next'));

        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            this.setupCarousel();
            this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
            this.updateCarousel();
            this.createPagination();
          }, 250);
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay && this.tiles.length > this.visibleCount) {
            this.startAutoplay();
          }
        });
      }

      navigate(direction) {
        if (this.isTransitioning) return;

        this.stopAutoplay();

        if (direction === 'prev') {
          this.currentIndex = Math.max(0, this.currentIndex - 1);
        } else {
          this.currentIndex = Math.min(this.maxIndex, this.currentIndex + 1);
        }

        this.updateCarousel();

        if (this.autoplay && this.tiles.length > this.visibleCount) {
          this.startAutoplay();
        }
      }

      updateCarousel() {
        this.isTransitioning = true;

        const tileWidth = this.tiles[0].offsetWidth;
        const gap = {{ block.settings.tile_gap }};
        const offset = this.currentIndex * (tileWidth + gap);

        this.carousel.style.transform = `translateX(-${offset}px)`;

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.maxIndex;

        this.updatePagination();

        setTimeout(() => {
          this.isTransitioning = false;
        }, 500);
      }

      createPagination() {
        this.paginationContainer.innerHTML = '';

        const totalPages = this.maxIndex + 1;

        if (totalPages <= 1) return;

        for (let i = 0; i < totalPages; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-featured-collections-dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to page ${i + 1}`);
          dot.addEventListener('click', () => {
            this.stopAutoplay();
            this.currentIndex = i;
            this.updateCarousel();
            if (this.autoplay && this.tiles.length > this.visibleCount) {
              this.startAutoplay();
            }
          });
          this.paginationContainer.appendChild(dot);
        }

        this.updatePagination();
      }

      updatePagination() {
        const dots = this.paginationContainer.querySelectorAll('.ai-featured-collections-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayTimer = setInterval(() => {
          if (this.currentIndex >= this.maxIndex) {
            this.currentIndex = 0;
          } else {
            this.currentIndex++;
          }
          this.updateCarousel();
        }, this.interval);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }
    }

    customElements.define('featured-collections-carousel-{{ ai_gen_id }}', FeaturedCollectionsCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Featured collections",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "inline_richtext",
      "id": "section_title",
      "label": "Section title",
      "default": "Udforsk kollektionerne"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Carousel settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "label": "Autoplay interval",
      "default": 5000
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Collections per row (desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "tile_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Space between tiles",
      "default": 20
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#F7F3EB"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 48
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#1A1A1A"
    },
    {
      "type": "header",
      "content": "Tile style"
    },
    {
      "type": "color",
      "id": "tile_background",
      "label": "Tile background",
      "default": "#F7F3EB"
    },
    {
      "type": "range",
      "id": "tile_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Tile corner radius",
      "default": 8
    },
    {
      "type": "font_picker",
      "id": "collection_name_font",
      "label": "Collection name font",
      "default": "playfair_display_n4"
    },
    {
      "type": "range",
      "id": "collection_name_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Collection name size",
      "default": 20
    },
    {
      "type": "color",
      "id": "collection_name_color",
      "label": "Collection name color",
      "default": "#1A1A1A"
    },
    {
      "type": "header",
      "content": "Navigation style"
    },
    {
      "type": "color",
      "id": "nav_color",
      "label": "Arrow color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "nav_active_color",
      "label": "Active arrow and dot color",
      "default": "#6C2D31"
    }
  ],
  "presets": [
    {
      "name": "Featured collections"
    }
  ]
}
{% endschema %}