      "label": "Kolor tytułu",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Grubość czcionki",
      "options": [
        {
          "value": "400",
          "label": "Normalna"
        },
        {
          "value": "500",
          "label": "Średnia"
        },
        {
          "value": "600",
          "label": "Półgruba"
        },
        {
          "value": "700",
          "label": "Gruba"
        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "title_transform",
      "label": "Styl tekstu",
      "options": [
        {
          "value": "none",
          "label": "Normalny"
        },
        {
          "value": "uppercase",
          "label": "WIELKIE LITERY"
        },
        {
          "value": "lowercase",
          "label": "małe litery"
        },
        {
          "value": "capitalize",
          "label": "Pierwsza Wielka"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Odstęp między literami",
      "min": -2,
      "max": 4,
      "step": 0.5,
      "default": 0
    },
    {
      "type": "header",
      "content": "Opis"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Pokaż opis kolekcji",
      "default": true
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Rozmiar opisu",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Kolor opisu",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "description_spacing",
      "label": "Odstęp od tytułu",
      "min": 0,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "Maksymalna szerokość opisu",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "header",
      "content": "Układ"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Wyrównanie tekstu",
      "options": [
        {
          "value": "left",
          "label": "Do lewej"
        },
        {
          "value": "center",
          "label": "Do środka"
        },
        {
          "value": "right",
          "label": "Do prawej"
        }
      ],
