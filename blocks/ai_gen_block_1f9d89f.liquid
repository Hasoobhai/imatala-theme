{% doc %}
  @prompt
    I want for every collection page the title of the collection as a header
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-header-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
    display: block;
  }

  .ai-collection-header__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size_desktop }}px;
    margin: 0;
    font-weight: {{ block.settings.title_weight }};
    text-transform: {{ block.settings.title_transform }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-collection-header__description-{{ ai_gen_id }} {
    color: {{ block.settings.description_color }};
    font-size: {{ block.settings.description_size }}px;
    margin-top: {{ block.settings.description_spacing }}px;
    max-width: {{ block.settings.description_max_width }}px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-collection-header__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-collection-header-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px {{ block.settings.padding_horizontal_mobile }}px {{ block.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if collection.title != blank %}
    <h1 class="ai-collection-header__title-{{ ai_gen_id }}">
      {{ collection.title }}
    </h1>
  {% endif %}

  {% if block.settings.show_description and collection.description != blank %}
    <div class="ai-collection-header__description-{{ ai_gen_id }}">
      {{ collection.description }}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Nagłówek kolekcji",
  "settings": [
    {
      "type": "header",
      "content": "Tytuł"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Rozmiar tytułu (desktop)",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "title_size_mobile",
