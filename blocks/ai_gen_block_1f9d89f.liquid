      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Odstępy (desktop)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding górny",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding dolny",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Padding poziomy",
      "min": 0,
      "max": 100,
      "step": 4,
