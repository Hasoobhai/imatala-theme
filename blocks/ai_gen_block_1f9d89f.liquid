    {
      "type": "header",
      "content": "Kolory"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Tło",
      "default": "#f7f3eb"
    }
  ],
  "presets": [
    {
      "name": "Nagłówek kolekcji"
    }
  ]
}
{% endschema %}