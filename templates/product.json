            "liquid": "<div class=\"product-info__liquid\">\n  <style>\n    :root {\n      --shipping-margin-top: -20px;\n      --shipping-margin-bottom: 20px;\n      --text-size: 14px;\n      --text-size-mobile: 12px;\n    }\n\n    .custom-shipping-container {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      background-color: #F5F5F5;\n      padding: 10px 15px;\n      border-radius: 8px;\n      margin-top: var(--shipping-margin-top);\n      margin-bottom: var(--shipping-margin-bottom);\n      overflow: hidden;\n    }\n\n    .custom-shipping-item {\n      display: flex;\n      align-items: center;\n      gap: 8px;\n      flex-shrink: 0;\n      max-width: 50%;\n    }\n\n    .green-circle {\n      flex-shrink: 0;\n      min-width: 10px;\n      width: 10px;\n      height: 10px;\n    }\n\n    .custom-icon {\n      width: 24px;\n      height: auto;\n      flex-shrink: 0;\n      border-radius: 50%;\n    }\n\n    .text-block-shipping {\n      font-size: var(--text-size);\n      font-weight: 500;\n      color: #333;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n    }\n\n    .shipping-date {\n      font-weight: 600;\n    }\n\n    @media screen and (max-width: 480px) {\n      .custom-shipping-container {\n        padding: 8px 12px;\n      }\n\n      .text-block-shipping {\n        font-size: var(--text-size-mobile);\n      }\n\n      .green-circle {\n        width: 8px;\n        height: 8px;\n      }\n\n      .custom-icon {\n        width: 18px;\n      }\n    }\n\n    @media screen and (max-width: 360px) {\n      .custom-shipping-container {\n        gap: 4px;\n        padding: 5px 6px;\n      }\n\n      .custom-shipping-item {\n        gap: 4px;\n      }\n\n      .green-circle {\n        width: 6px;\n        height: 6px;\n      }\n\n      .custom-icon {\n        width: 16px;\n      }\n\n      .text-block-shipping {\n        font-size: 10px;\n      }\n    }\n  </style>\n\n  <div class=\"custom-shipping-container\">\n    <div class=\"custom-shipping-item\">\n      <svg class=\"green-circle\" xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 12 12\">\n        <circle cx=\"6\" cy=\"6\" r=\"6\" fill=\"#137333\"></circle>\n      </svg>\n      <div class=\"text-block-shipping\">\n        Spedito <span id=\"shipping-date\" class=\"shipping-date\">ven. 5 set</span>\n      </div>\n    </div>\n    <div class=\"custom-shipping-item\">\n      <svg class=\"custom-icon\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 3 2\" aria-label=\"Italian flag\">\n        <rect width=\"1\" height=\"2\" x=\"0\" fill=\"#009246\"></rect>\n        <rect width=\"1\" height=\"2\" x=\"1\" fill=\"#F1F2F1\"></rect>\n        <rect width=\"1\" height=\"2\" x=\"2\" fill=\"#CE2B37\"></rect>\n      </svg>\n      <div class=\"text-block-shipping\">Spedizione gratuita</div>\n    </div>\n  </div>\n\n  <script>\n    function getTomorrowDate() {\n      const today = new Date();\n      const tomorrow = new Date(today);\n      tomorrow.setDate(tomorrow.getDate() + 1);\n      const dayNames = [\"dom.\", \"lun.\", \"mar.\", \"mer.\", \"gio.\", \"ven.\", \"sab.\"];\n      const dayOfWeek = dayNames[tomorrow.getDay()];\n      const monthNames = [\"gen\", \"feb\", \"mar\", \"apr\", \"mag\", \"giu\", \"lug\", \"ago\", \"set\", \"ott\", \"nov\", \"dic\"];\n      const month = monthNames[tomorrow.getMonth()];\n      return `${dayOfWeek} ${tomorrow.getDate()} ${month}`;\n    }\n\n    function setShippingDate() {\n      const shippingDateElement = document.getElementById(\"shipping-date\");\n      if (shippingDateElement) {\n        shippingDateElement.textContent = getTomorrowDate();\n      }\n    }\n\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\"DOMContentLoaded\", setShippingDate);\n    } else {\n      setShippingDate();\n    }\n\n    window.addEventListener(\"load\", setShippingDate);\n  </script>\n</div>"
